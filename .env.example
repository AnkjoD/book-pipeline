# ============================================================
# Hardcover Data Pipeline — Environment Variables
# Sao chép file này thành .env rồi điền giá trị thực.
# ============================================================

# ── Hardcover API ─────────────────────────────────────────────
# Lấy tại https://hardcover.app/account/api
HARDCOVER_API_KEY=your_token_here

# ── MinIO (Data Lake) ─────────────────────────────────────────
# Khi chạy qua docker-compose: MINIO_ENDPOINT=minio:9000 (tên service)
# Khi test local (MinIO chạy riêng): MINIO_ENDPOINT=localhost:9000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hardcover-lake

# ── Airflow ───────────────────────────────────────────────────
# Fernet key để mã hóa connection passwords trong Airflow metadata DB.
# Tạo bằng lệnh:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Để trống thì Airflow tự tạo (có warning, OK cho dev).
AIRFLOW_FERNET_KEY=

# Secret key cho Airflow webserver session — đổi thành random string dài.
AIRFLOW_SECRET_KEY=changeme_to_random_secret

# ── Postgres pgvector (RAG vector store) ─────────────────────
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5433
VECTOR_DB_NAME=books_rag
VECTOR_DB_USER=rag
VECTOR_DB_PASSWORD=rag

